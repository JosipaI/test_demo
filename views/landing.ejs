<!DOCTYPE html>
<html>

<head>
    <title>LAB1</title>
    <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
    <link rel="stylesheet" href="/styles/landing.css">

</head>

<body class="content">

<main class="main">
    <section class="section">
        <h1>Dobrodošli na Loto 6/45</h1>

        <p>
        <% if (user) { %>
            <h3>Welcome, <%= user.displayName || user.nickname %>!</h3>
            <a href="/logout">Logout</a>
        <% } else { %>
            <h3>You are not logged in.</h3>
            <a href="/login">Login</a>
        <% } %>
        </p>

        <h2>Kontrola kola</h2>

        <form action="/store-results" method="post">
        <input type="text" name="numbers" placeholder="Brojevi:" />
        <input type="text" name="oib" placeholder="Broj OIB-a ili putovnice:" />
        <button type="submit">Pohrani brojeve</button>

        <p>Provjerite svoj listić:</p>
        <form action="/check-ticket/view" method="GET">
        <input type="text" name="ticket_id" placeholder="Vas kod listica" required>
        <button type="submit">Prikaži listić</button>
        </form>
        </form>

    </section> 
</main>

</body>

</html>