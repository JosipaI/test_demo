<!DOCTYPE html>
<html>

<head>
    <title>LAB1</title>
    <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
</head>

<body class="content">

<main class="main">
    <section class="section">
        <h1>First try of LAB1</h1>

        <p>
        <% if (user) { %>
            <h3>Welcome, <%= user.displayName || user.nickname %>!</h3>
            <a href="/logout">Logout</a>
        <% } else { %>
            <h3>You are not logged in.</h3>
            <a href="/login">Login</a>
        <% } %>
        </p>

        <h2>Kontrola kola</h2>
        <form action="/new-round" method="post">
        <button type="submit">Otvori novo kolo</button>
        </form>

        <form action="/close" method="post">
        <button type="submit">Zatvori kolo</button>
        </form>

        <form action="/store-results" method="post">
        <input type="text" name="numbers" placeholder="Brojevi odvojeni zarezima" />
        <button type="submit">Spremi rezultate</button>
        </form>

    </section> 
</main>

</body>

</html>