<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Listić <%= ticket.ticket_id %></title>

</head>
<body>
  <h1>Listić <%= ticket.ticket_id %></h1>

  <p><b>OIB ili putovnica:</b> <%= ticket.oib %></p>
  <p><b>Brojevi na listicu:</b> <%= ticket.numbers.join(', ') %></p>
  
  <% if(round.numbers) { %>
    <p><b>Izvuceni brojevi u zadnjem kolu:</b> <%= round.numbers.join(', ') %></p>
  <% } else { %>
    <p>Rezultati još nisu izvučeni.</p>
  <% } %>

  <div>
    <h3>QR kod za ovaj listic:</h3>
    <img src="/ticket/<%= ticket.ticket_id %>/qrcode" alt="QR kod">
  </div>
</body>
</html>
